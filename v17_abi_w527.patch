+static int eta6947_charger_probe(struct i2c_client *client,
+		const struct i2c_device_id *id)
+{
+	struct i2c_adapter *adapter = to_i2c_adapter(client->dev.parent);
+	struct device *dev = &client->dev;
+	struct power_supply_config charger_cfg = { };
+	struct eta6947_charger_info *info;
+	struct device_node *regmap_np;
+	struct platform_device *regmap_pdev;
+	int ret;
+
+	if (!i2c_check_functionality(adapter, I2C_FUNC_SMBUS_BYTE_DATA)) {
+		dev_err(dev, "No support for SMBUS_BYTE_DATA\n");
+		return -ENODEV;
+	}
+
+	info = devm_kzalloc(dev, sizeof(*info), GFP_KERNEL);
+	if (!info)
+		return -ENOMEM;
+	info->client = client;
+	info->dev = dev;
+
+	alarm_init(&info->otg_timer, ALARM_BOOTTIME, NULL);
+
+	mutex_init(&info->lock);
+	INIT_WORK(&info->work, eta6947_charger_work);
+
+	i2c_set_clientdata(client, info);
+
+	info->usb_phy = devm_usb_get_phy_by_phandle(dev, "phys", 0);
+	if (IS_ERR(info->usb_phy)) {
+		dev_err(dev, "failed to find USB phy\n");
+		return PTR_ERR(info->usb_phy);
+	}
+
+	info->edev = extcon_get_edev_by_phandle(info->dev, 0);
+	if (IS_ERR(info->edev)) {
+		dev_err(dev, "failed to find vbus extcon device.\n");
+		return PTR_ERR(info->edev);
+	}
+
+	ret = eta6947_charger_register_vbus_regulator(info);
+	if (ret) {
+		dev_err(dev, "failed to register vbus regulator.\n");
+		return ret;
+	}
+
+	regmap_np = of_find_compatible_node(NULL, NULL, "sprd,sc27xx-syscon");
+	if (!regmap_np) {
+		dev_err(dev, "unable to get syscon node\n");
+		return -ENODEV;
+	}
+
+	ret = of_property_read_u32_index(regmap_np, "reg", 1,
+					 &info->charger_detect);
+	if (ret) {
+		dev_err(dev, "failed to get charger_detect\n");
+		return -EINVAL;
+	}
+
+	info->gpiod = devm_gpiod_get_optional(dev, "chg-enable", ENABLE_CHARGE);
+	if (IS_ERR(info->gpiod)) {
+		dev_err(dev, "failed to get enable gpio\n");
+		return PTR_ERR(info->gpiod);
+	}
+
+	ret = of_property_read_u32_index(regmap_np, "reg", 2,
+					 &info->charger_pd);
+	if (ret) {
+		dev_err(dev, "failed to get charger_pd reg\n");
+		return ret;
+	}
+
+	if (of_device_is_compatible(regmap_np->parent, "sprd,sc2730"))
+		info->charger_pd_mask = ETA6947_DISABLE_PIN_MASK_2730;
+	else if (of_device_is_compatible(regmap_np->parent, "sprd,sc2721"))
+		info->charger_pd_mask = ETA6947_DISABLE_PIN_MASK_2721;
+	else if (of_device_is_compatible(regmap_np->parent, "sprd,sc2720"))
+		info->charger_pd_mask = ETA6947_DISABLE_PIN_MASK_2720;
+	else {
+		dev_err(dev, "failed to get charger_pd mask\n");
+		return -EINVAL;
+	}
+
+	regmap_pdev = of_find_device_by_node(regmap_np);
+	if (!regmap_pdev) {
+		of_node_put(regmap_np);
+		dev_err(dev, "unable to get syscon device\n");
+		return -ENODEV;
+	}
+
+	of_node_put(regmap_np);
+	info->pmic = dev_get_regmap(regmap_pdev->dev.parent, NULL);
+	if (!info->pmic) {
+		dev_err(dev, "unable to get pmic regmap device\n");
+		return -ENODEV;
+	}
+
+	charger_cfg.drv_data = info;
+	charger_cfg.of_node = dev->of_node;
+	info->psy_usb = devm_power_supply_register(dev,
+						   &eta6947_charger_desc,
+						   &charger_cfg);
+	if (IS_ERR(info->psy_usb)) {
+		dev_err(dev, "failed to register power supply\n");
+		return PTR_ERR(info->psy_usb);
+	}
+	
+	// 注册一个名为 "usb" 的别名设备，让 Health HAL 能找到充电器在线信息
+    info->psy_usb_alias = devm_power_supply_register(dev, &usb_charger_desc, &charger_cfg);
+    if (IS_ERR(info->psy_usb_alias)) {
+        dev_err(dev, "failed to register alias usb power supply, err = %ld\n",
+                PTR_ERR(info->psy_usb_alias));
+        return PTR_ERR(info->psy_usb_alias);
+    }
+    
+	ret = eta6947_charger_hw_init(info);
+	if (ret)
+		return ret;
+
+	info->usb_notify.notifier_call = eta6947_charger_usb_change;
+	ret = usb_register_notifier(info->usb_phy, &info->usb_notify);
+	if (ret) {
+		dev_err(dev, "failed to register notifier:%d\n", ret);
+		return ret;
+	}
+
+	eta6947_charger_detect_status(info);
+	INIT_DELAYED_WORK(&info->otg_work, eta6947_charger_otg_work);
+	INIT_DELAYED_WORK(&info->wdt_work,
+			  eta6947_charger_feed_watchdog_work);
+
+	/* factory alignment (r54): /sys/class/eta6947 debug class */
+	info->dbg_class = class_create(THIS_MODULE, "eta6947");
+	if (IS_ERR(info->dbg_class)) {
+		dev_err(dev, "failed to create eta6947 debug class\n");
+		info->dbg_class = NULL;
+	} else {
+		info->dbg_dev = device_create_with_groups(info->dbg_class, dev,
+							  MKDEV(0, 0), info,
+							  eta6947_groups,
+							  "eta6947");
+		if (IS_ERR(info->dbg_dev)) {
+			dev_err(dev, "failed to create eta6947 debug device\n");
+			info->dbg_dev = NULL;
+			class_destroy(info->dbg_class);
+			info->dbg_class = NULL;
+		}
+	}
+
+	dev_info(dev, "Hello!Do you want to eat 6947?SoraNeko is waiting for you!\n");
+
+	return 0;
+}
+
+static int eta6947_charger_remove(struct i2c_client *client)
+{
+	struct eta6947_charger_info *info = i2c_get_clientdata(client);
+
+	/* factory alignment (r54): tear down debug class */
+	if (info->dbg_dev) {
+		device_destroy(info->dbg_class, MKDEV(0, 0));
+		info->dbg_dev = NULL;
+	}
+	if (info->dbg_class) {
+		class_destroy(info->dbg_class);
+		info->dbg_class = NULL;
+	}
+
+	usb_unregister_notifier(info->usb_phy, &info->usb_notify);
+
+	return 0;
+}
