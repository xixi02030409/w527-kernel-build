+#define ETA6947_CHG_IMSTEP		(200000)
+#define ETA6947_CHG_IMMAX		(3050000)
+#define ETA6947_CHG_IMIN		(550000)
+#define ETA6947_CHG_ISTEP		(100000)
+#define ETA6947_CHG_IMAX		(3050000)
+#define ETA6947_CHG_IMAX30500		(0x19)
+
+#define ETA6947_CHG_VMREG_MIN		(4200)
+#define ETA6947_CHG_VMREG_STEP		(20)
+#define ETA6947_CHG_VMREG_MAX		(4760)
+#define ETA6947_CHG_VOREG_MIN		(3500)
+#define ETA6947_CHG_VOREG_STEP		(20)
+#define ETA6947_CHG_VOREG_MAX		(4760)
