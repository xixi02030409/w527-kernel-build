+static ssize_t attr_get_enable(struct device *dev,struct device_attribute *attr, char *buf)
+{
+	struct qmc6308_data *qmc6308 = dev_get_drvdata(dev);
+	int val;
+
+	mutex_lock(&qmc6308->lock);
