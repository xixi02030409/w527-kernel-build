+#define ETA6947_REG_EN_ILIM_2_SHIFT			(3)
+#define ETA6947_REG_IIN_LIMIT_2_MASK			GENMASK(2, 0)
+#define ETA6947_REG_IIN_LIMIT_2_SHIFT			(0)
