+	struct power_supply_charge_current cur;
+	struct work_struct work;
+	struct mutex lock;
+	bool charging;
+	u32 limit;
+	struct delayed_work otg_work;
+	struct delayed_work wdt_work;
+	struct regmap *pmic;
+	struct power_supply *psy_usb_alias;
+	u32 charger_detect;
+	u32 charger_pd;
+	u32 charger_pd_mask;
+	struct gpio_desc *gpiod;
+	struct extcon_dev *edev;
+	bool otg_enable;
+	struct alarm otg_timer;
+	bool need_reinit;
+	/* factory alignment (r54): throttled psy notification + debug class */
+	unsigned long last_changed;
+	struct class *dbg_class;
+	struct device *dbg_dev;
+};
+
+static int eta6947_charger_set_limit_current(struct eta6947_charger_info *info, u32 limit_cur);
+
+static bool eta6947_charger_is_bat_present(struct eta6947_charger_info *info)
+{
+	struct power_supply *psy;
+	union power_supply_propval val;
+	bool present = false;
+	int ret;
+
+	psy = power_supply_get_by_name(ETA6947_BATTERY_NAME);
+	if (!psy) {
+		dev_err(info->dev, "Failed to get psy of sc27xx_fgu\n");
+		return present;
+	}
+	ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_PRESENT,
+					&val);
+	if (ret == 0 && val.intval)
+		present = true;
+	power_supply_put(psy);
+
+	if (ret)
+		dev_err(info->dev,
+			"Failed to get property of present:%d\n", ret);
+
+	return present;
+}
+
+static int eta6947_read(struct eta6947_charger_info *info, u8 reg, u8 *data)
+{
+	int ret;
+
+	ret = i2c_smbus_read_byte_data(info->client, reg);
+	if (ret < 0)
+		return ret;
+
+	*data = ret;
+	return 0;
+}
+
+static int eta6947_write(struct eta6947_charger_info *info, u8 reg, u8 data)
+{
+	return i2c_smbus_write_byte_data(info->client, reg, data);
+}
+
+static int eta6947_update_bits(struct eta6947_charger_info *info, u8 reg, u8 mask, u8 data)
+{
+	u8 v;
+	int ret;
+
+	ret = eta6947_read(info, reg, &v);
+	if (ret < 0)
+		return ret;
+
+	v &= ~mask;
+	v |= (data & mask);
+
+	return eta6947_write(info, reg, v);
+}
+
+static int eta6947_charger_set_max_batt_reg_vol(struct eta6947_charger_info *info, u32 vol)
+{
+	u8 reg_val;
+
+	if (vol < ETA6947_CHG_VMREG_MIN)
+		vol = ETA6947_CHG_VMREG_MIN;
+	else if (vol > ETA6947_CHG_VMREG_MAX)
+		vol = ETA6947_CHG_VMREG_MAX;
+
+	reg_val = (vol - ETA6947_CHG_VMREG_MIN) / ETA6947_CHG_VMREG_STEP;
+
+	return eta6947_update_bits(info, ETA6947_REG_6, ETA6947_REG_VMREG_MASK,
+				   (reg_val << ETA6947_REG_VMREG_SHIFT));
+}
+
+/*
+ * factory alignment (r54): rate-limit power_supply_changed to once per
+ * 125 jiffies (1.25s @ HZ=100). Decompiled from factory kernel
+ * eta6947_psy_changed_throttled @ ffffff80086292bc.
+ */
+static void eta6947_psy_changed_throttled(struct eta6947_charger_info *info)
+{
+	unsigned long now = jiffies;
+
+	if (time_after_eq(now, info->last_changed + HZ + HZ / 4)) {
+		info->last_changed = now;
+		power_supply_changed(info->psy_usb);
+	}
+}
+
+/*
+ * factory alignment (r54): dump REG0-9 for debug, mirrors factory
+ * eta6947_dump_reg @ ffffff8008629438 ("[eta6947x] %s %d : REG xx: 0x%02x").
+ */
+static void eta6947_dump_reg(struct eta6947_charger_info *info)
+{
+	u8 val;
+	int i, ret;
+
+	for (i = 0; i <= 9; i++) {
+		ret = eta6947_read(info, i, &val);
+		if (ret)
+			continue;
+		dev_info(info->dev, "%s %d : REG %02d: 0x%02x\n",
+			 __func__, __LINE__, i, val);
+	}
+}
+
+/*
+ * factory alignment (r54): read constant-charge voltage (mV) from the
+ * sc27xx-fgu power supply's battery info, mirrors factory
+ * eta6947_read_cv_mv @ ffffff8008629fb0 (fgu name string kept identical).
+ */
+static int eta6947_read_cv_mv(int *cv_mv)
+{
+	struct power_supply *psy;
+	struct power_supply_battery_info bat_info = { };
+	int ret;
+
+	psy = power_supply_get_by_name("sc27xx-fgu");
+	if (!psy)
+		return -ENODEV;
+
+	ret = power_supply_get_battery_info(psy, &bat_info);
+	if (!ret && cv_mv)
+		*cv_mv = bat_info.constant_charge_voltage_max_uv / 1000;
+	power_supply_put_battery_info(psy, &bat_info);
+
+	return ret;
+}
+
+static int eta6947_charger_set_termina_vol(struct eta6947_charger_info *info, u32 vol)
+{
+	u8 reg_val;
+
+	if (vol < ETA6947_CHG_VOREG_MIN)
+		vol = ETA6947_CHG_VOREG_MIN;
+	else if (vol > ETA6947_CHG_VOREG_MAX)
+		vol =  ETA6947_CHG_VOREG_MAX;
+
+	reg_val = (vol - ETA6947_CHG_VOREG_MIN) / ETA6947_CHG_VOREG_STEP;
+
+	dev_info(info->dev, "%s %d : set termina vol, vol=%d\n",
+		 __func__, __LINE__, vol);
+	dev_info(info->dev, "%s %d : reg_val=0x%02x\n",
+		 __func__, __LINE__, reg_val << ETA6947_REG_VOREG_SHIFT);
+
+	return eta6947_update_bits(info, ETA6947_REG_2, ETA6947_REG_VOREG_MASK,
+				   reg_val << ETA6947_REG_VOREG_SHIFT);
+}
+
+static int eta6947_charger_set_max_chg_cur(struct eta6947_charger_info *info, u32 cur)
+{
+	u8 reg_val;
+	int i;
+
+	/*if ICHG_OFFSET = 1, chg cur + 100mA*/
+	cur -= 100 * ETA6947_REG_ICHG_OFFSET;
+	for (i = 1; i < ARRAY_SIZE(eta6947_max_chg_cur); ++i)
+		if (cur < eta6947_max_chg_cur[i])
+			break;
+
+	reg_val = i - 1;
+
+	return eta6947_update_bits(info, ETA6947_REG_6, ETA6947_REG_IMCHRG_MASK,
+				    reg_val << ETA6947_REG_IMCHRG_SHIFT);
+}
+
+static int eta6947_charger_hw_init(struct eta6947_charger_info *info)
+{
+	struct power_supply_battery_info bat_info = { };
+	int voltage_max_microvolt;
+	int ret;
+
+	ret = power_supply_get_battery_info(info->psy_usb, &bat_info);
+	if (ret) {
+		dev_warn(info->dev, "no battery information is supplied, ret = %d\n", ret);
+		voltage_max_microvolt = 4200;
+
+		/*
+		 * If no battery information is supplied, we should set
+		 * default charge termination current to 100 mA, and default
+		 * charge termination voltage to 4.2V.
+		 */
+		info->cur.sdp_limit = 500000;
+		info->cur.sdp_cur = 500000;
+		info->cur.dcp_limit = 20000000;
+		info->cur.dcp_cur = 2000000;
+		info->cur.cdp_limit = 11500000;
+		info->cur.cdp_cur = 1150000;
+		info->cur.unknown_limit = 5000000;
+		info->cur.unknown_cur = 500000;
+	} else {
+		info->cur.sdp_limit = bat_info.cur.sdp_limit;
+		info->cur.sdp_cur = bat_info.cur.sdp_cur;
+		info->cur.dcp_limit = bat_info.cur.dcp_limit;
+		info->cur.dcp_cur = bat_info.cur.dcp_cur;
+		info->cur.cdp_limit = bat_info.cur.cdp_limit;
+		info->cur.cdp_cur = bat_info.cur.cdp_cur;
+		info->cur.unknown_limit = bat_info.cur.unknown_limit;
+		info->cur.unknown_cur = bat_info.cur.unknown_cur;
+
+		voltage_max_microvolt =
+			bat_info.constant_charge_voltage_max_uv / 1000;
+		power_supply_put_battery_info(info->psy_usb, &bat_info);
+
+		if (of_device_is_compatible(info->dev->of_node,
+					    "eta,eta6947_chg")) {
+			ret = eta6947_update_bits(info, ETA6947_REG_4,
+						  ETA6947_REG_RESET_MASK,
+						  ETA6947_REG_RESET_MASK);
+			if (ret) {
+				dev_err(info->dev, "reset eta6947 failed ret = %d\n", ret);
+				return ret;
+			}
+
+			ret = eta6947_charger_set_max_batt_reg_vol(info,
+						voltage_max_microvolt);
+			if (ret) {
+				dev_err(info->dev, "set eta6947 safety vol failed ret = %d\n", ret);
+				return ret;
+			}
+
+			ret = eta6947_charger_set_max_chg_cur(info,
+						info->cur.dcp_cur);
+			if (ret) {
+				dev_err(info->dev, "set eta6947 safety cur failed, ret = %d\n", ret);
+				return ret;
+			}
+		}
+
+		/* do not force charge to 550mA */
+		ret = eta6947_update_bits(info, ETA6947_REG_5, ETA6947_REG_LOW_CHG_MASK, 0);
+		if (ret) {
+			dev_err(info->dev, "release eta6947 force charge failed ret = %d\n", ret);
+			return ret;
+		}
+		/* set wake battery voltage threshold 3.4V */
+		ret = eta6947_update_bits(info, ETA6947_REG_1, ETA6947_REG_VLOWV_MASK, 0);
+		if (ret) {
+			dev_err(info->dev, "set eta6947 weak voltage threshold failed ret = %d\n", ret);
+			return ret;
+		}
+		/* set ichg offset , ichg begain from 550mA or 650mA*/
+		ret = eta6947_update_bits(info, ETA6947_REG_4, ETA6947_REG_ICHG_OFFSET_MASK,
+					  ETA6947_REG_ICHG_OFFSET << ETA6947_REG_ICHG_OFFSET_SHIFT);
+		if (ret) {
+			dev_err(info->dev, "set eta6947 io level failed ret = %d\n", ret);
+			return ret;
+		}
+		/*set VOREG 4.3V?*/
+		ret = eta6947_update_bits(info, ETA6947_REG_2, ETA6947_REG_VOREG_MASK,
+					  ETA6947_REG_VOREG << ETA6947_REG_VOREG_SHIFT);
+		if (ret) {
+			dev_err(info->dev, "set eta6947 VOREG failed ret = %d\n", ret);
+			return ret;
+		}
+		/*Disable termination charge current function*/
+		ret = eta6947_update_bits(info, ETA6947_REG_1, ETA6947_REG_TE_MASK, 0);
+		if (ret) {
+			dev_err(info->dev, "set eta6947 terminal cur failed ret = %d\n", ret);
+			return ret;
+		}
+
+		/*Feed Watchdog*/
+		ret = eta6947_update_bits(info,	ETA6947_REG_0, ETA6947_REG_TMR_RST_OTG_STAT_MASK,
+					  ETA6947_REG_TMR_RST_OTG_STAT_MASK);
+		if (ret) {
+			dev_err(info->dev, "feed eta6947 watchdog failed ret = %d\n", ret);
+			return ret;
+		}
+
+		/*input current limit sel*/
+		ret = eta6947_update_bits(info,	ETA6947_REG_7, ETA6947_REG_EN_ILIM_2_MASK,
+					  ETA6947_IIN_LIM_SEL << ETA6947_REG_EN_ILIM_2_SHIFT);
+		if (ret) {
+			dev_err(info->dev, "feed eta6947 watchdog failed ret = %d\n", ret);
+			return ret;
+		}
+
+		ret = eta6947_charger_set_termina_vol(info, voltage_max_microvolt);
+		if (ret) {
+			dev_err(info->dev, "set eta6947 terminal vol failed ret = %d\n", ret);
+			return ret;
+		}
+
+		ret = eta6947_charger_set_limit_current(info, info->cur.unknown_cur);
+		if (ret)
+			dev_err(info->dev, "set eta6947 limit current failed ret = %d\n", ret);
+	}
+
+	return ret;
+}
+
+static int eta6947_charger_start_charge(struct eta6947_charger_info *info)
+{
+	int ret = 0;
+
+	if (info->gpiod) {
+		gpiod_set_value_cansleep(info->gpiod, ENABLE_CHARGE);
+	} else {
+		ret = regmap_update_bits(info->pmic, info->charger_pd,
+					 info->charger_pd_mask, 0);
+		if (ret)
+			dev_err(info->dev, "enable eta6947 charge failed ret = %d\n", ret);
+	}
+
+	return ret;
+}
+
+static void eta6947_charger_stop_charge(struct eta6947_charger_info *info)
+{
+	int ret;
+
+	if (info->gpiod) {
+		gpiod_set_value_cansleep(info->gpiod, DISABLE_CHARGE);
+	} else {
+		ret = regmap_update_bits(info->pmic, info->charger_pd,
+					 info->charger_pd_mask,
+					 info->charger_pd_mask);
+		if (ret)
+			dev_err(info->dev, "disable eta6947 charge failed ret = %d\n", ret);
+	}
+}
+
+static int eta6947_charger_set_current(struct eta6947_charger_info *info, u32 cur)
+{
+	u8 reg_val;
+	int ret;
+
+	/*if ICHG_OFFSET = 1, chg cur + 100mA*/
+	cur -= 100 * ETA6947_REG_ICHG_OFFSET;
+
+	if (cur < ETA6947_CHG_IMIN)
+		cur = ETA6947_CHG_IMIN;
+	else if (cur > ETA6947_CHG_IMAX)
+		cur = ETA6947_CHG_IMAX;
+
+	reg_val = (cur - ETA6947_CHG_IMIN) / ETA6947_CHG_ISTEP;
+	/*set reg 4 ichg[2:0]*/
+	ret = eta6947_update_bits(info, ETA6947_REG_4, ETA6947_REG_ICHG_MASK,
+				    (reg_val & 0x7) << ETA6947_REG_ICHG_SHIFT);
+	if (ret) {
+		dev_err(info->dev, "set eta6947 ichg[2:0] cur failed ret = %d\n", ret);
+		return ret;
+	}
+	/*set reg5 ichg[4:3]*/
+	ret = eta6947_update_bits(info, ETA6947_REG_5, ETA6947_REG_ICHG_3_MASK | ETA6947_REG_ICHG_4_MASK,
+				    ((reg_val & 0x18) >> 0x3) << ETA6947_REG_ICHG_3_SHIFT);
+	if (ret)
+		dev_err(info->dev, "set eta6947 ichg[4:3] cur failed ret = %d\n", ret);
+
+	return ret;
+}
+
+static int eta6947_charger_get_current(struct eta6947_charger_info *info, u32 *cur)
+{
+	u8 reg_val = 0, val;
+	int ret;
+
+	ret = eta6947_read(info, ETA6947_REG_4, &val);
+	if (ret < 0) {
+		dev_err(info->dev, "set eta6947 ichg[2:0] cur failed ret = %d\n", ret);
+		return ret;
+	}
+
+	val &= ETA6947_REG_ICHG_MASK;
+	val = val >> ETA6947_REG_ICHG_SHIFT;
+	reg_val |= val;
+
+	ret = eta6947_read(info, ETA6947_REG_5, &val);
+	if (ret < 0) {
+		dev_err(info->dev, "set eta6947 ichg[3:4] cur failed ret = %d\n", ret);
+		return ret;
+	}
+
+	val &= (ETA6947_REG_ICHG_3_MASK | ETA6947_REG_ICHG_4_MASK);
+	val = (val >> ETA6947_REG_ICHG_3_SHIFT << 0x3);
+	reg_val |= val;
+
+	if (reg_val > ETA6947_CHG_IMAX30500)
+		reg_val = ETA6947_CHG_IMAX30500;
+
+	*cur = reg_val * ETA6947_CHG_ISTEP + ETA6947_CHG_IMIN + 100 * ETA6947_REG_ICHG_OFFSET;
+
+	return 0;
+}
+
+static int eta6947_charger_set_limit1_current(struct eta6947_charger_info *info, u32 limit_cur)
+{
+	u8 reg_val;
+	int i;
+
+	if (limit_cur > eta6947_iin_lim1_tbl[ARRAY_SIZE(eta6947_iin_lim1_tbl) - 1]) {
+		reg_val = ARRAY_SIZE(eta6947_iin_lim1_tbl);
+	} else {
+		for (i = 1; i < ARRAY_SIZE(eta6947_iin_lim1_tbl); ++i)
+			if (limit_cur < eta6947_iin_lim1_tbl[i])
+				break;
+
+		reg_val = i - 1;
+	}
+
+	return eta6947_update_bits(info, ETA6947_REG_1, ETA6947_REG_IIN_LIMIT_1_MASK,
+				   reg_val << ETA6947_REG_IIN_LIMIT_1_SHIFT);
+}
+
+
+static int eta6947_charger_set_limit2_current(struct eta6947_charger_info *info, u32 limit_cur)
+{
+	u8 reg_val;
+	int i;
+
+	for (i = 1; i < ARRAY_SIZE(eta6947_iin_lim2_tbl); ++i)
+		if (limit_cur < eta6947_iin_lim2_tbl[i])
+			break;
+
+	reg_val = i - 1;
+
+	return eta6947_update_bits(info, ETA6947_REG_7, ETA6947_REG_IIN_LIMIT_2_MASK,
+				    reg_val << ETA6947_REG_IIN_LIMIT_2_SHIFT);
+}
+
+static int eta6947_charger_set_limit_current(struct eta6947_charger_info *info, u32 limit_cur)
+{
+	int ret;
+
+	if (ETA6947_IIN_LIM_SEL)
+		ret = eta6947_charger_set_limit2_current(info, limit_cur);
+	else
+		ret = eta6947_charger_set_limit1_current(info, limit_cur);
+
+	if (ret)
+		dev_err(info->dev, "set eta6947 ichg[2:0] cur failed ret = %d\n", ret);
+
+	return ret;
+}
+
+static int eta6947_charger_get_limit1_current(struct eta6947_charger_info *info, u32 *limit_cur)
+{
+	u8 reg_val;
+	int ret;
+
+	ret = eta6947_read(info, ETA6947_REG_1, &reg_val);
+	if (ret < 0) {
+		dev_err(info->dev, "set eta6947 limit1 cur failed ret = %d\n", ret);
+		return ret;
+	}
+
+	reg_val &= ETA6947_REG_IIN_LIMIT_1_MASK;
+	reg_val = reg_val >> ETA6947_REG_IIN_LIMIT_1_SHIFT;
+
+	if (reg_val >= ARRAY_SIZE(eta6947_iin_lim1_tbl))
+		*limit_cur = ETA6947_REG_IIN_LIMIT1_MAX;
+	else
+		*limit_cur = eta6947_iin_lim1_tbl[reg_val];
+
+	return ret;
+}
+
+static int eta6947_charger_get_limit2_current(struct eta6947_charger_info *info, u32 *limit_cur)
+{
+	u8 reg_val;
+	int ret;
+
+	ret = eta6947_read(info, ETA6947_REG_7, &reg_val);
+	if (ret < 0) {
+		dev_err(info->dev, "set eta6947 limit2 cur failed ret = %d\n", ret);
+		return ret;
+	}
+
+	reg_val &= ETA6947_REG_IIN_LIMIT_2_MASK;
+	reg_val = reg_val >> ETA6947_REG_IIN_LIMIT_2_SHIFT;
+
+	if (reg_val >= ARRAY_SIZE(eta6947_iin_lim2_tbl))
+		reg_val = ARRAY_SIZE(eta6947_iin_lim2_tbl) - 1;
+
+	*limit_cur = eta6947_iin_lim2_tbl[reg_val];
+
+	return ret;
+}
+
+static int eta6947_charger_get_limit_current(struct eta6947_charger_info *info, u32 *limit_cur)
+{
+	int ret;
+
+	if (ETA6947_IIN_LIM_SEL)
+		ret = eta6947_charger_get_limit2_current(info, limit_cur);
+	else
+		ret = eta6947_charger_get_limit1_current(info, limit_cur);
+
+	if (ret)
+		dev_err(info->dev, "set eta6947  get limit cur failed ret = %d\n", ret);
+
+	return ret;
+}
+
+static int eta6947_charger_get_online(struct eta6947_charger_info *info,
+				     u32 *online)
+{
+	if (info->limit)
+		*online = true;
+	else
+		*online = false;
+
+	return 0;
+}
+
+static int eta6947_charger_feed_watchdog(struct eta6947_charger_info *info,
+					  u32 val)
+{
+	int ret;
+	(void)val;
+
+	ret = eta6947_update_bits(info, ETA6947_REG_0, ETA6947_REG_TMR_RST_OTG_STAT_MASK,
+				  ETA6947_REG_TMR_RST_OTG_STAT_MASK);
+	if (ret)
+		dev_err(info->dev, "eta6947 feed watchdog failed ret = %d\n", ret);
+
+	return ret;
+}
+
+static int eta6947_charger_get_status(struct eta6947_charger_info *info)
+{
+	if (info->charging)
+		return POWER_SUPPLY_STATUS_CHARGING;
+	else
+		return POWER_SUPPLY_STATUS_NOT_CHARGING;
+}
+
+static int eta6947_charger_set_status(struct eta6947_charger_info *info, int val)
+{
+	int ret = 0;
+
+	if (!val && info->charging) {
+		eta6947_charger_stop_charge(info);
+		info->charging = false;
+	} else if (val && !info->charging) {
+		ret = eta6947_charger_start_charge(info);
+		if (ret)
+			dev_err(info->dev, "start charge failed\n");
+		else
+			info->charging = true;
+	}
+
+	return ret;
+}
+
+static void eta6947_charger_work(struct work_struct *data)
+{
+	struct eta6947_charger_info *info =
+		container_of(data, struct eta6947_charger_info, work);
+	int limit_cur, cur, ret;
+	bool present = eta6947_charger_is_bat_present(info);
+
+	mutex_lock(&info->lock);
+
+	if (info->limit > 0 && !info->charging && present) {
+		if (info->need_reinit) {
+			ret = eta6947_charger_hw_init(info);
+			if (ret)
+				goto out;
+			info->need_reinit = false;
+		}
+		/* set current limitation and start to charge */
+		switch (info->usb_phy->chg_type) {
+		case SDP_TYPE:
+			limit_cur = info->cur.sdp_limit;
+			cur = info->cur.sdp_cur;
+			break;
+		case DCP_TYPE:
+			limit_cur = info->cur.dcp_limit;
+			cur = info->cur.dcp_cur;
+			break;
+		case CDP_TYPE:
+			limit_cur = info->cur.cdp_limit;
+			cur = info->cur.cdp_cur;
+			break;
+		default:
+			limit_cur = info->cur.unknown_limit;
+			cur = info->cur.unknown_cur;
+		}
+
+		ret = eta6947_charger_set_limit_current(info, limit_cur);
+		if (ret)
+			goto out;
+
+		ret = eta6947_charger_set_current(info, cur);
+		if (ret)
+			goto out;
+
+		ret = eta6947_charger_start_charge(info);
+		if (ret)
+			goto out;
+
+		info->charging = true;
+	} else if ((!info->limit && info->charging) || !present) {
+		/* Stop charging */
+		info->charging = false;
+		eta6947_charger_stop_charge(info);
+	}
+
+out:
+	mutex_unlock(&info->lock);
+	dev_info(info->dev, "battery present = %d, charger type = %d\n",
+		 present, info->usb_phy->chg_type);
+	cm_notify_event(info->psy_usb, CM_EVENT_CHG_START_STOP, NULL);
+}
+
+
+static int eta6947_charger_usb_change(struct notifier_block *nb,
+				       unsigned long limit, void *data)
+{
+	struct eta6947_charger_info *info =
+		container_of(nb, struct eta6947_charger_info, usb_notify);
+
+	info->limit = limit;
+
+	schedule_work(&info->work);
+	return NOTIFY_OK;
+}
+
+static int eta6947_charger_usb_get_property(struct power_supply *psy,
+					     enum power_supply_property psp,
+					     union power_supply_propval *val)
+{
+	struct eta6947_charger_info *info = power_supply_get_drvdata(psy);
+	u32 cur, online;
+	enum usb_charger_type type;
+	int ret = 0;
+
+	mutex_lock(&info->lock);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		if (info->limit)
+			val->intval = eta6947_charger_get_status(info);
+		else
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		break;
+
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		if (!info->charging) {
+			val->intval = 0;
+		} else {
+			ret = eta6947_charger_get_current(info, &cur);
+			if (ret)
+				goto out;
+
+			val->intval = cur;
+		}
+		break;
+
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		if (!info->charging) {
+			val->intval = 0;
+		} else {
+			ret = eta6947_charger_get_limit_current(info, &cur);
+			if (ret)
+				goto out;
+
+			val->intval = cur;
+		}
+		break;
+
+	case POWER_SUPPLY_PROP_ONLINE:
+		ret = eta6947_charger_get_online(info, &online);
+		if (ret)
+			goto out;
+
+		val->intval = online;
+
+		break;
+
+    case POWER_SUPPLY_PROP_HEALTH:
+        val->intval = POWER_SUPPLY_HEALTH_GOOD;
+        break;
+    
+	case POWER_SUPPLY_PROP_USB_TYPE:
+		type = info->usb_phy->chg_type;
+
+		switch (type) {
+		case SDP_TYPE:
+			val->intval = POWER_SUPPLY_USB_TYPE_SDP;
+			break;
+
+		case DCP_TYPE:
+			val->intval = POWER_SUPPLY_USB_TYPE_DCP;
+			break;
+
+		case CDP_TYPE:
+			val->intval = POWER_SUPPLY_USB_TYPE_CDP;
+			break;
+
+		default:
+			val->intval = POWER_SUPPLY_USB_TYPE_UNKNOWN;
+		}
+
+		break;
+
+	default:
+		ret = -EINVAL;
+	}
+
+out:
+	mutex_unlock(&info->lock);
+	return ret;
+}
+
+static int eta6947_charger_usb_set_property(struct power_supply *psy,
+					    enum power_supply_property psp,
+					    const union power_supply_propval *val)
+{
+	struct eta6947_charger_info *info = power_supply_get_drvdata(psy);
+	int ret;
+
+	mutex_lock(&info->lock);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+		ret = eta6947_charger_set_current(info, val->intval);
+		if (ret < 0)
+			dev_err(info->dev, "set charge current failed\n");
+		break;
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+		ret = eta6947_charger_set_limit_current(info, val->intval);
+		if (ret < 0)
+			dev_err(info->dev, "set input current limit failed\n");
+		break;
+
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = eta6947_charger_set_status(info, val->intval);
+		if (ret < 0)
+			dev_err(info->dev, "set charge status failed\n");
+		break;
+
+	case POWER_SUPPLY_PROP_FEED_WATCHDOG:
+		ret = eta6947_charger_feed_watchdog(info, val->intval);
+		if (ret < 0)
+			dev_err(info->dev, "feed charger watchdog failed\n");
+		break;
+
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_VOLTAGE_MAX:
+		ret = eta6947_charger_set_termina_vol(info, val->intval / 1000);
+		if (ret < 0)
+			dev_err(info->dev, "failed to set terminate voltage\n");
+		break;
+
+	default:
+		ret = -EINVAL;
+	}
+
+	/*
+	 * factory alignment (r54): after a successful property write, notify
+	 * the power supply framework (throttled) and dump registers, mirrors
+	 * factory usb_set_property tail (psy_changed_throttled + dump_reg).
+	 */
+	if (ret >= 0 && psp != POWER_SUPPLY_PROP_FEED_WATCHDOG) {
+		if (psp == POWER_SUPPLY_PROP_STATUS && val->intval) {
+			int cv = 0;
+
+			/* re-align charge termination voltage with fgu battery info */
+			if (!eta6947_read_cv_mv(&cv) && cv)
+				eta6947_charger_set_termina_vol(info, cv);
+		}
+		eta6947_psy_changed_throttled(info);
+		eta6947_dump_reg(info);
+	}
+
+	mutex_unlock(&info->lock);
+	return ret;
+}
+
+static int eta6947_charger_property_is_writeable(struct power_supply *psy,
+						enum power_supply_property psp)
+{
+	int ret;
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT:
+	case POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT:
+	case POWER_SUPPLY_PROP_STATUS:
+		ret = 1;
+		break;
+
+	default:
+		ret = 0;
+	}
+
+	return ret;
+}
+
+/*
+ * factory alignment (r54): /sys/class/eta6947/eta6947/eta6947_info debug
+ * interface, mirrors factory eta6947_class/eta6947_group/eta6947_attrs/
+ * eta6947_info_show/eta6947_info_store. show = decode REG0 STAT1_STAT2
+ * charge state; store = manual charge current set (550-3150 mA).
+ */
+static ssize_t eta6947_info_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct eta6947_charger_info *info = dev_get_drvdata(dev);
+	const char *state;
+	u8 val = 0;
+	int ret;
+
+	ret = eta6947_read(info, ETA6947_REG_0, &val);
+	if (ret)
+		state = "charge unknown";
+	else {
+		switch ((val >> 4) & 0x3) {
+		case 1:
+			state = "charge in progress";
+			break;
+		case 2:
+			state = "charge done";
+			break;
+		case 3:
+			state = "charge fault";
+			break;
+		default:
+			state = "charge ready";
+			break;
+		}
+	}
+
+	dev_info(info->dev, "%s %d : %s\n", __func__, __LINE__, state);
+	return scnprintf(buf, PAGE_SIZE, "%s\n", state);
+}
+
+static ssize_t eta6947_info_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct eta6947_charger_info *info = dev_get_drvdata(dev);
+	int val, ret;
+
+	ret = kstrtoint(buf, 10, &val);
+	if (ret)
+		return ret;
+
+	/* factory range check: unsigned (val - 550) <= 2600 => [550, 3150] mA */
+	if (val < 550 || val - 550 > 2600) {
+		dev_err(info->dev, "eta6947: current %d mA out of range (%d-%d)\n",
+			val, 550, 3150);
+		return -EINVAL;
+	}
+
+	ret = eta6947_charger_set_current(info, val * 1000);
+	if (ret) {
+		dev_err(info->dev, "eta6947: set current %d mA failed, ret = %d\n",
+			val, ret);
+		return ret;
+	}
+
+	return count;
+}
+
+static DEVICE_ATTR(eta6947_info, 0644, eta6947_info_show, eta6947_info_store);
