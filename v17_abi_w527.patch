+#define QMC6308_SET_MODE		  			_IOW(QMC6308_IOCTL_BASE, 1, int)
+#define QMC6308_SET_RANGE		  			_IOW(QMC6308_IOCTL_BASE, 2, int)
+#define QMC6308_READ_MAGN_XYZ	  			_IOR(QMC6308_IOCTL_BASE, 3, char *)
