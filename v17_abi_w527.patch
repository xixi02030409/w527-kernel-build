+#if 0
+	if ( misc_deregister(&qmc_compass_dev) < 0)
+		dev_err(&client->dev, "misc deregister failed.");
+#else
+	misc_deregister(&qmc_compass_dev);
+#endif
+	input_unregister_device(dev->input);
+	kfree(dev);
+	
+	dev_info(&client->dev, "successfully removed.");
+	return 0;
+}
