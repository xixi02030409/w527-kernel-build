-		if (info->reg_midr)						\
-			return sprintf(buf, "0x%016x\n", info->reg_##_field);	\
-		else								\
-			return 0;						\
-	}									\
-	static struct kobj_attribute cpuregs_attr_##_name = __ATTR_RO(_name)
