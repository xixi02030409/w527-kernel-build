+static int
+eta6947_charger_register_vbus_regulator(struct eta6947_charger_info *info)
+{
+	struct regulator_config cfg = { };
+	struct regulator_dev *reg;
+	int ret = 0;
+
+	cfg.dev = info->dev;
+	cfg.driver_data = info;
+	reg = devm_regulator_register(info->dev,
+				      &eta6947_charger_vbus_desc, &cfg);
+	if (IS_ERR(reg)) {
+		ret = PTR_ERR(reg);
+		dev_err(info->dev, "Can't register regulator:%d\n", ret);
+	}
+
+	return ret;
+}
